# Cloudflare R2 (S3 compatible)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=chordshift
R2_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_REGION=auto

# Optional: public URL base for browser access (custom domain or r2.dev)
# R2_CUSTOM_DOMAIN=https://pub-xxxx.r2.dev

# --- PostgreSQL (필수) ---
DB_HOST=svc.sel3.cloudtype.app
DB_PORT=30315
DB_NAME=chordshift
DB_USER=
DB_PASSWORD=
